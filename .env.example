# ============================================================
# blog-mas — Example environment configuration
# Ch10 §1.1: Twelve-Factor App — separate config from code.
#
# Copy this file to .env for local development.
# NEVER commit .env to version control.
# In production, these are injected by K8s ConfigMaps/Secrets
# or fetched by the secrets management backend at startup.
# ============================================================


# ─────────────────────── LLM Providers ───────────────────────────────────────
# At least one of OPENAI_API_KEY or HF_TOKEN must be set.
# Ch10: "the application should integrate with [secrets] systems at startup."

OPENAI_API_KEY=sk-...
HF_TOKEN=hf_...

# Generation and embedding model names.
# Override per environment — dev can use cheaper models, prod uses best.
GENERATION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Legacy: local LM Studio URL (kept for backward compat with dev setup)
LM_STUDIO_URL=http://127.0.0.1:1234


# ─────────────────────── Token budget (Ch10 §2.1) ────────────────────────────
# When an input exceeds SUMMARIZER_TRIGGER_TOKENS, the Summarizer agent
# fires automatically BEFORE the primary reasoning agent.  This is the
# "proactive context reduction" policy from Ch10 §2.1.

SUMMARIZER_TRIGGER_TOKENS=4000
MAX_INPUT_TOKENS=32000


# ─────────────────────── Vector store ────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=blog-mas-knowledge
BLUEPRINT_COLLECTION=blog-mas-blueprints
RETRIEVAL_TOP_K=5

# Set to "false" to skip sanitisation for fully-trusted corpora (rare).
INGEST_SANITIZATION_ENABLED=true


# ─────────────────────── Async task queue (Ch10 §1.3) ────────────────────────
# Redis is the broker AND result backend in this reference setup.
# In a larger deployment, swap the broker for RabbitMQ or Amazon SQS.

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
RESULT_BACKEND_URL=redis://localhost:6379/1

# How long to retain completed task results (seconds). 86400 = 24 hours.
RESULT_TTL_SECONDS=86400

WORKER_CONCURRENCY=4
MAX_TASK_RETRIES=3


# ─────────────────────── Observability (Ch10 §1.4) ───────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: "json" for production (machine-readable), "console" for dev.
# The ELK/Splunk stack expects JSON. Grafana Loki also parses JSON natively.
LOG_FORMAT=console

# OpenTelemetry → OTLP → Jaeger (Ch10: "Jaeger or Zipkin make these flows visible")
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=blog-mas

# Where ExecutionTrace JSON files are persisted (the immutable audit log).
TRACE_STORE_DIR=data/traces


# ─────────────────────── Security (Ch10 §1.2 / §2.4) ────────────────────────
# API key for /api/v1/* endpoints.
# In production, this is enforced at the API gateway (Kong / AWS API GW / Istio).
# The service-level check here is a defence-in-depth second layer.
API_KEY=dev-local-key-change-me

# Set to "false" only in integration tests.  Never false in production.
API_PREFLIGHT_MODERATION=true

# HMAC secret for signing outbound webhook payloads.
WEBHOOK_SECRET=change-me-in-production


# ─────────────────────── Secrets backend (Ch10 §1.1) ─────────────────────────
# HashiCorp Vault (used when SECRETS_BACKEND=vault)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-only-token

# AWS Secrets Manager (used when SECRETS_BACKEND=aws)
AWS_DEFAULT_REGION=us-east-1


# ─────────────────────── Runtime environment ─────────────────────────────────
# "development" | "staging" | "production"
# Production mode enables eager startup validation (fails fast if any required
# env var is missing, so the K8s pod fails its readiness probe rather than
# discovering the missing key mid-request).
ENV=development
